PORT=8080
MYSQL_DSN=root:root@tcp(127.0.0.1:3307)/ai_pay?parseTime=true
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
ADMIN_BEARER_TOKEN=
READONLY_BEARER_TOKEN=
CALLBACK_TOKEN=
CALLBACK_SIGNING_SECRET=
WEBHOOK_SIGNING_SECRET=

# Optional: when a merchant uses channel route mode ASYNC, each SETTLING pay order POSTs JSON to this URL (event=payment.settling). Your relay completes on-chain / external x402, then calls POST /payment/status/callback.
EXTERNAL_SETTLEMENT_WEBHOOK_URL=
# HMAC-SHA256 of raw JSON body; header X-AgentTrust-Signature: sha256=<hex>
EXTERNAL_SETTLEMENT_WEBHOOK_SECRET=
# Optional, default 8000
EXTERNAL_SETTLEMENT_WEBHOOK_TIMEOUT_MS=

# Stripe subscription checkout (fiat). Create Products/Prices in Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# Public URL of the Next.js app (success/cancel redirect from Stripe Checkout)
APP_PUBLIC_URL=http://127.0.0.1:3000
